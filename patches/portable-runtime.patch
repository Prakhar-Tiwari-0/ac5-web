+ * calls retain a C frame, exactly as the native thunk does; the existing
+ * depth guard bounds pending after callbacks during guest tail-jump loops. */
+static hook_site *site_of(u32 guest);
+ps2_fn ps2_hook_enter_portable(u32 guest, ps2_fn body, ps2_ctx *ctx) {
+    hook_site *s = site_of(guest);
+    if (!s) return body;
+    hook_entry chain[HOOK_MAX_CHAIN];
+    unsigned n = s->nbefore;
+    s->calls++;
+    if (n) {
+        memcpy(chain, s->before, n * sizeof *chain);
+        for (unsigned i = 0; i < n; ++i) chain[i].fn(ctx, chain[i].user);
+    }
+    ps2_hook_fn rep = s->replacement;
+    void *rep_user = s->replacement_user;
+    n = s->nafter;
+    if (!n || call_depth >= HOOK_MAX_CALL_DEPTH) {
+        if (n) s->after_skipped++;
+        if (rep) {
+            if (rep(ctx, rep_user)) return NULL;
+            s->declined++;
+        }
+        return body;
+    }
+    hook_frame fr;
+    memcpy(chain, s->after, n * sizeof *chain);
+    for (int i = 0; i < 8; ++i) fr.args[i] = ctx->r[4 + i].uw[0];
+    fr.sp = ctx->r[29].uw[0];
+    fr.prev = cur_frame;
+    ++call_depth;
+    if (!rep || !rep(ctx, rep_user)) {
+        if (rep) s->declined++;
+        body(ctx);
+    }
+    cur_frame = &fr;
+    for (unsigned i = 0; i < n; ++i) chain[i].fn(ctx, chain[i].user);
+    cur_frame = fr.prev;
+    --call_depth;
+    return NULL;
